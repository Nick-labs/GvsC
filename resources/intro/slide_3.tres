[resource]
script = ExtResource("1_217mw")
image = ExtResource("1_sxakg")
text = "I built my farm out of blue wood. They say foxes can't stand this color. But I still see them watching me. They're just waiting for me to fall asleep. Every night they come to the fence. They need my eggs and my birds. I have an old crossbow on the roof to keep them away from the gate. Let's see if I can hold out for another day..."
duration = 999.0
metadata/_custom_type_script = "uid://dmjn35k24jf0n"
