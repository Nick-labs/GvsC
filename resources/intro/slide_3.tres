[ext_resource type="Texture2D" uid="uid://1e5mk03wy0w0" path="res://assets/sprites/intro/cg-farm.png" id="1_sxakg"]

[resource]
script = ExtResource("1_217mw")
image = ExtResource("1_sxakg")
text = "Я построил свою ферму из синего дерева. Говорят, лисы не переносят этот цвет. Но все равно я вижу их, наблюдающих за мной. Они просто ждут, когда я усну. Каждую ночь они подходят к забору. Им нужны мои яйца и мои пернатые. У меня есть старый арбалет на крыше, чтобы отгонять их от ворот. Посмотрим, смогу ли я продержаться еще один день..."
duration = 999.0
metadata/_custom_type_script = "uid://dmjn35k24jf0n"
